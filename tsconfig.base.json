{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@juth/api": ["./packages/api/src/index.ts"],
      "@juth/types": ["./packages/types/src/index.ts"],
      "@juth/ui": ["./packages/ui/src/index.ts"]
    }
  }
}
